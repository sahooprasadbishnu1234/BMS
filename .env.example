# ==========================================
# ENTERPRISE BANKING MANAGEMENT SYSTEM (BMS)
# ENVIRONMENT CONFIGURATION TEMPLATE
# ==========================================

# Application Port & Node Environment
NODE_ENV=development
PORT=4000
API_PREFIX=/api/v1

# Frontend URL (For CORS allow-list)
FRONTEND_URL=http://localhost:5173

# Database Configuration (PostgreSQL 18+)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/bms_db?schema=public"

# Authentication & Cryptographic Secrets
# (Generate in production via: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))")
JWT_ACCESS_SECRET="enterprise_bms_jwt_access_secret_key_change_in_production_981247"
JWT_ACCESS_EXPIRATION="15m"
JWT_REFRESH_SECRET="enterprise_bms_jwt_refresh_secret_key_change_in_production_451829"
JWT_REFRESH_EXPIRATION="7d"

# Argon2id Hashing Parameters
ARGON2_MEMORY_COST=65536
ARGON2_TIME_COST=3
ARGON2_PARALLELISM=4

# Financial Limits & Maker-Checker Thresholds
MAKER_CHECKER_TRANSFER_THRESHOLD=10000.00
DAILY_ATM_WITHDRAWAL_LIMIT=2000.00
MAX_UNAUTHENTICATED_LOGIN_ATTEMPTS=5
ACCOUNT_LOCKOUT_DURATION_MINUTES=15

# Audit & Compliance Thresholds
AML_LARGE_CASH_REPORTING_THRESHOLD=10000.00
AML_VELOCITY_TX_COUNT_HOURLY=5
